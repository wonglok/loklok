{
  "name": "@effectnode/b3sync",
  "version": "0.1.2",
  "description": "AI‑Agent‑Optimized CLI — structured output, predictable behaviour, zero prompts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "loklok": "./bin/loklok.js"
  },
  "files": [
    "bin",
    "dist",
    "src/web",
    "src/web/client",
    "src/web/index.html",
    "src/web/vite.config.ts",
    "src/web/tailwind.config.js",
    "src/web/public"
  ],
  "scripts": {
    "deploy": "npm version patch; npm publish --access public;",
    "build": "tsup",
    "dev": "concurrently \" npm run dev:cli \" \" nodemon ./bin/loklok.js web --no-open\"",
    "dev:cli": "tsup --watch",
    "dev:web": "cd src/web && vite",
    "build:web": "cd src/web && vite build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "cli",
    "ai-agent",
    "structured-output",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@effectnode/b3sync": "^0.0.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.4",
    "commander": "^13.1.0",
    "cors": "^2.8.6",
    "esbuild-plugin-raw": "^0.4.2",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "open": "^10.2.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "vite-express": "^0.21.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {}
}
